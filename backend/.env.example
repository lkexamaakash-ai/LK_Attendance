PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Code required to register a super admin at /register
CODE=change_me

# Password given to every newly created user. They must change it on first login.
DEFAULT_PASSWORD=lkacademy

# Extra allowed frontend URL(s), comma separated, no trailing slash
FRONTEND_URL=https://your-frontend.vercel.app
